# miniace environment
#
# Copy to .env and adjust:  cp .env.example .env
# Engine options: an empty value does not pass the flag, so the engine keeps
# its factory default. Units: Kb/s for rate limits, bytes for cache sizes.

# -- VPN (ProtonVPN WireGuard) -----------------------------------------------
# Generate a WireGuard configuration at https://account.proton.me/vpn/WireGuard
# with the "NAT-PMP (Port Forwarding)" option ENABLED, then copy the value of
# the PrivateKey field here. Port forwarding requires a paid ProtonVPN plan
# (Plus/Unlimited) and a server that supports it.
# WireGuard private key from the ProtonVPN configuration (required).
WG_PRIVATE_KEY=
# VPN server country or countries used for selection (comma-separated).
PROTON_COUNTRIES=Netherlands

# -- Ports ---------------------------------------------------------------------
# Host port published for the AceStream engine HTTP API (stream endpoint,
# published through gluetun). The container port stays 6878.
ACESTREAM_HTTP_PORT=6878
# Host port published for the playlist HTTP server (generated .m3u files).
# The container port stays 8080.
PLAYLISTS_PORT=8080

# -- Playlist sync ---------------------------------------------------------------
# Seconds between playlist refreshes. sources.json is re-read every cycle,
# so edits apply without restarting.
SYNC_INTERVAL=3600
# Local Kubo gateway (inside the Docker network) used for IPNS resolution.
IPFS_GATEWAY=http://kubo:48080
# Public gateways tried when local IPNS resolution fails or is slow
# (comma-separated URLs).
IPFS_FALLBACK_GATEWAYS=https://ipfs.filebase.io,https://ipfs.io,https://dweb.link,https://w3s.link

# -- Engine: connection and slot budgets -----------------------------------------
# Adaptive slots grow with upload demand up to the per-stream peer ceiling.
# Requirement: startup slots <= startup peers <= peer limit <= connections.
# Total engine connection ceiling (all streams, both directions).
ACESTREAM_MAX_CONNECTIONS=2000
# Adaptive peer ceiling per active stream.
ACESTREAM_MAX_PEERS_LIMIT=500
# Peer budget at engine start (passed as --max-peers and --startup-max-peers).
ACESTREAM_STARTUP_MAX_PEERS=100
# Upload-slot budget at engine start, before the adaptive loop adjusts it.
ACESTREAM_STARTUP_UPLOAD_SLOTS=50
# Manual upload-slot ceiling (factory 10). With FIX_UPLOAD_SLOTS=1 the live
# manager sizes slots on demand; this ceiling applies when adaptive mode is
# off (0) and to VOD.
ACESTREAM_MAX_UPLOAD_SLOTS=
# Manual upload-slot floor (factory 6).
ACESTREAM_MIN_UPLOAD_SLOTS=
# 1 = adaptive slot manager (default); 0 = fixed manual slots.
ACESTREAM_FIX_UPLOAD_SLOTS=1
# Connections reserved for timeshift (live-seek) peers.
ACESTREAM_MAX_TIMESHIFT_PEERS=

# -- Engine: rate limits (Kb/s) ----------------------------------------------------
# Upload rate limit in Kb/s; 0 = unlimited.
ACESTREAM_UPLOAD_LIMIT=0
# Download rate limit in Kb/s; 0 = unlimited.
ACESTREAM_DOWNLOAD_LIMIT=0

# -- Engine: slot manager tuning ------------------------------------------------------
# 1 = apply the CPU thresholds below to slot changes; 0 = grow freely (default).
ACESTREAM_SLOTS_MANAGER_USE_CPU_LIMIT=0
# Slot floor under CPU pressure (factory 12); slots never drop below it.
ACESTREAM_SLOTS_MANAGER_MIN_SLOTS=
# Total CPU % below which slots may rise (factory 20).
ACESTREAM_SLOTS_MANAGER_CPU_LOW_LIMIT=
# Total CPU % above which slots fall (factory 25).
ACESTREAM_SLOTS_MANAGER_CPU_HIGH_LIMIT=
# Per-core CPU % below which slots may rise (factory 70).
ACESTREAM_SLOTS_MANAGER_CPU_LOW_LIMIT_PER_CORE=
# Per-core CPU % above which slots fall (factory 85).
ACESTREAM_SLOTS_MANAGER_CPU_HIGH_LIMIT_PER_CORE=
# Per-peer upload cost ceiling in bytes/s (factory 307200 = 2.4 Mbps): the
# adaptive loop divides measured upload by min(stream bitrate, this value).
ACESTREAM_SLOTS_MANAGER_BASE_BITRATE=
# Multiplier from measured upload to wanted slots (factory 2).
ACESTREAM_WANTED_SLOTS_FACTOR=
# Multiplier applied to past upload rates at engine start (factory 3).
ACESTREAM_STARTUP_SLOTS_FACTOR=
# Seconds between adaptive slot adjustments (factory 5).
ACESTREAM_FIX_UPLOAD_SLOTS_INTERVAL=

# -- Engine: stream cache -----------------------------------------------------------
# Disk cache budget in GB for downloaded pieces; 0 = no disk caching.
ACESTREAM_CACHE_LIMIT_GB=5
# Live-stream cache backend: auto (default) = disk when the disk budget is
# above 0 GB, memory when it is 0. Set disk or memory to force it.
ACESTREAM_LIVE_CACHE_TYPE=auto
# Same as above for VOD playback.
ACESTREAM_VOD_CACHE_TYPE=auto
# Live memory-cache size in bytes (engine default when empty).
ACESTREAM_LIVE_MEM_CACHE_SIZE=
# Live disk-cache size in bytes (engine default when empty).
ACESTREAM_LIVE_DISK_CACHE_SIZE=
# RAM cache limit in bytes (engine default when empty).
ACESTREAM_MEMORY_CACHE_LIMIT=

# -- Engine: playback and logging --------------------------------------------------------
# VOD playback buffer in seconds.
ACESTREAM_VOD_BUFFER=30
# Engine log level on container stdout: error, info, debug or any.
ACESTREAM_LOG_STDOUT_LEVEL=info
# Rotating engine log file: maximum size in bytes (default 10 MB).
ACESTREAM_LOG_MAX_SIZE=10485760
# Rotating engine log file: number of backups.
ACESTREAM_LOG_BACKUP_COUNT=1
# Comma-separated engine modules to log verbosely (for example prefs,live).
ACESTREAM_VERBOSE_MODULES=

# -- Engine: extra flags (power users) -------------------------------------------------------
# Extra engine CLI flags: space-separated --flag[=value] tokens, appended
# after the generated ones (the last occurrence wins). Options miniace manages
# (connection budgets, rate limits, cache, buffer, ports, paths) are rejected
# here; set their dedicated variables instead.
# Example: --close-connections-from-same-peer
ACESTREAM_EXTRA_FLAGS=

# -- Port rotation watcher -----------------------------------------------------------------------
# Seconds between checks of the Gluetun-announced forwarded port. When it
# changes, the engine restarts to rebind (a brief interruption).
PORT_WATCH_INTERVAL_S=10

# -- Misc -----------------------------------------------------------------------------------------
# Timezone for the containers (logs).
TZ=Europe/Madrid
# Docker Compose network subnet. Must not overlap the VPN tunnel range
# (ProtonVPN WireGuard uses 10.x.x.x). Kept in sync with FIREWALL_OUTBOUND_SUBNETS.
DOCKER_SUBNET=172.30.0.0/24
