# miniace environment
#
# Copy to .env and adjust:  cp .env.example .env
# The engine is outpace; its tuning lives in the OUTPACE_* block below.
# An empty value leaves the built-in default in place.

# -- VPN (ProtonVPN WireGuard) -----------------------------------------------
# Generate a WireGuard configuration at https://account.proton.me/vpn/WireGuard
# with the "NAT-PMP (Port Forwarding)" option ENABLED, then copy the value of
# the PrivateKey field here. Port forwarding requires a paid ProtonVPN plan
# (Plus/Unlimited) and a server that supports it.
# WireGuard private key from the ProtonVPN configuration (required).
WG_PRIVATE_KEY=
# VPN server country or countries used for selection (comma-separated).
PROTON_COUNTRIES=Netherlands

# -- Ports ---------------------------------------------------------------------
# Host port published for the AceStream engine HTTP API (stream endpoint,
# published through gluetun). The container port stays 6878.
ACESTREAM_HTTP_PORT=6878
# Host port published for the playlist HTTP server (generated .m3u files).
# The container port stays 8080.
PLAYLISTS_PORT=8080

# -- Playlist sync ---------------------------------------------------------------
# Seconds between playlist refreshes. sources.json is re-read every cycle,
# so edits apply without restarting. Sources that fail are retried every
# RETRY_INTERVAL (60 s by default) until the next cycle.
SYNC_INTERVAL=3600
# Local Kubo gateway (inside the Docker network) used for IPNS resolution.
IPFS_GATEWAY=http://kubo:48080
# Public gateways tried when local IPNS resolution fails or is slow
# (comma-separated URLs). ipfs.io, dweb.link and w3s.link were retired on
# 2026-09-21 (HTTP 429/403, or a redirect to the retired dweb.link); the
# default below is the only public gateway verified to serve both /ipfs/
# and /ipns/ paths. Any gateway added here must support /ipns/ resolution.
IPFS_FALLBACK_GATEWAYS=https://ipfs.filebase.io

# -- Engine: outpace -----------------------------------------------------------------
# outpace is the Rust AceStream-compatible engine used on amd64, arm64 and
# armv7. It binds the P2P port announced by ProtonVPN and exposes the
# /ace/getstream endpoint used by the generated playlists.
#
# Retained-piece cache backend: memory or disk. Disk keeps per-stream pieces
# under /acestream/outpace/cache and is wiped on startup; memory is the
# default and does not touch the disk.
OUTPACE_CACHE_TYPE=memory
# Hard byte ceiling per active stream for retained pieces (128 MiB).
OUTPACE_SEED_STORE_BYTES=134217728
# Seconds of recent pieces kept for reseeding; 0 disables the age bound and
# falls back to OUTPACE_SEED_STORE_BYTES alone.
OUTPACE_SEED_RETENTION_SECS=45
# Maximum inbound peer connections accepted by the daemon.
OUTPACE_MAX_INBOUND=64
# Active upstream peers used to follow one live stream.
OUTPACE_MAX_ACTIVE_UPSTREAMS=4
# Peer connect race batch size per stream.
OUTPACE_MAX_PARALLEL_CONNECT=12
# Per-client fan-out channel depth (messages buffered per client).
OUTPACE_SESSION_BUFFER=256
# Startup prebuffer byte ceiling per stream (128 MiB). Lower it on small
# ARM boards running several streams at once.
OUTPACE_PREBUFFER_BYTES=134217728
# 1 = accept inbound peers and seed them; 0 = pure leecher.
OUTPACE_ENABLE_INBOUND=1
# 1 = upload pieces over outbound peer connections; 0 = disable reciprocal upload.
OUTPACE_ENABLE_SEEDING=1

# -- Port rotation watcher -----------------------------------------------------------------------
# Seconds between checks of the Gluetun-announced forwarded port. When it
# changes, the engine restarts to rebind (a brief interruption).
PORT_WATCH_INTERVAL_S=10

# -- Misc -----------------------------------------------------------------------------------------
# Timezone for the containers (logs).
TZ=Europe/Madrid
# Docker Compose network subnet. Must not overlap the VPN tunnel range
# (ProtonVPN WireGuard uses 10.x.x.x). Kept in sync with FIREWALL_OUTBOUND_SUBNETS.
DOCKER_SUBNET=172.30.0.0/24
